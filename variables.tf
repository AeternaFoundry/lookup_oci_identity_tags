variable "identity_tags_lookup" {
  description = <<EOT
Map of identity_tags_lookup, attributes below
Required:
    - tag_namespace_id
Optional:
    - state
    - filter (block):
        - name (required)
        - regex (optional)
        - values (required)
EOT

  type = map(object({
    tag_namespace_id = string
    state            = optional(string)
    filter = optional(list(object({
      name   = string
      regex  = optional(bool)
      values = list(string)
    })))
  }))
}

